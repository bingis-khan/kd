use Tui
	Screen

use Pos
	Pos
use TextBuf
	TextBuf, Cursor
use CharType
	char-type, is-word-boundary
use Theme
	Theme
use Config
	Config

Mode
	Normal
	Insert
	Select

inst Eq Mode
	eq (l _, r _):
		(case (l, r))
			(Normal, Normal): True
			(Insert, Insert): True
			(Select, Select): True
			_: False

inst Str Mode
	chars (self _): (case self) chars()
		Normal: 'Normal'
		Insert: 'Insert'
		Select: 'Select'
		_: todo()

fn short-mode-name (mode Mode):
	(case mode)
		Normal: 'NOR'
		Insert: 'INS'
		Select: 'SEL'
		_: todo()


# all of them are `si` (screen index shit)
ScreenCursorOffset
	screen-top I32
	screen-left I32


Pane al
	buf Ptr (TextBuf al)
	cursors List al Cursor
	current-cursor List.Idx
	mode Mode
	sc-off ScreenCursorOffset

fn mk (al al, buf Ptr (TextBuf al)) -> Pane al <= Allocator al: Pane
	{ buf
	, cursors: List.from-one(al, { pos: Pos.mk(0, 0), vi: 0, sel: None })
	, current-cursor: 0
	, mode: Normal
	, sc-off: { screen-top: 0, screen-left: 0 }
	}


# line processing
# bi = byte index
# vi = visual index (uses wcwidth)
# si = screen index (coordinates for Tui, ignores wcwidth) (to convert to it, just convert to vi. then just iterate over chars.)

# later make it configurable.
fn char-replacement (c Char) -> Maybe StrView
	if c == '\t'
		return '  ' Just()
	else
		return None

fn char-screen-width (c Char) -> I32: char-replacement(c) Misc.maybe(fn s: s chars() count() Mem.size-i32(), Term.rendered-wcwidth(c))


fn current-cursor (self Ptr (Pane al)) -> Cursor: self&.cursors[self&.current-cursor]
fn cursors (self Ptr (Pane al)): List.addresses(self&.cursors)

fn vi-bi (self Ptr (TextBuf al), ln I32, vx I32) -> I32
	bi = 0 as I32
	vi = 0
	for c in self TextBuf.line(ln) chars()
		vi <= vi + c char-screen-width()
		if vx < vi
			break

		bi <= bi + c.num-bytes Mem.size-i32()

	return bi

# basically bi-vi, put we also need the line, so it's the same as pos.
fn pos-vi (self Ptr (TextBuf al), pos Pos) -> I32
	bi = 0 as I32
	vi = 0
	for c in self TextBuf.line(pos.line) chars()
		bi <= bi + c.num-bytes Mem.size-i32()
		if pos.bi < bi
			break

		vi <= vi + c char-screen-width()

	return vi

fn char-at(pane Ptr (Pane al), pos Pos)
	line = pane&.buf TextBuf.line(pos.line)
	return line
		StrView.byte-substr(pos.bi Mem.i32-size(), line StrView.num-bytes())
		chars()
		head()
		or-else('\n')


fn is-in-selection (self Ptr (Pane al), pos Pos): self&.cursors
	map-maybe(fn cur: cur.sel Misc.fmap-maybe(fn s: (s, cur.pos)))
	any(fn ((sel, pos)): pos Math.between(pos, sel))


# maybe this should not be here?
# note: also when i make a proper rendered version, i'll be able to pass negative numbers to display even more text?
ScreenDims
	from-sx I32
	to-sx   I32  # ie. last possible index
	from-sy I32
	to-sy   I32  # ie. last possible index

# screen size for the total pane, including pane's margin. different from total pane area
fn screen-width (sd ScreenDims): sd.to-sx - sd.from-sx + 1
fn screen-height (sd ScreenDims): sd.to-sy - sd.from-sy + 1

fn update-screen-offset (pane Ptr (Pane al), sd ScreenDims)
	cur = pane current-cursor()
	cur = cur.pos
	cur-sx = pane&.buf pos-vi(cur)
	sc-off = pane&.sc-off

	# not really width/height, sort of "offset so that the cursor arrives at right/lower-most position"
	sw = sd screen-width() - 1
	sh = sd screen-height() - 1

	xmargin = 5  # default margin.
	ymargin = xmargin
	
	if sw <= xmargin * 2
		xmargin <= if sw > 3: 1 else 0
	if sh <= ymargin * 2
		ymargin <= if sh > 3: 1 else 0

	csi = pane&.buf pos-vi(cur)  # this takes into account screen tab len n shii
	csx = csi - sc-off.screen-left
	csy = cur.line - sc-off.screen-top

	nu-screen-left = sc-off.screen-left
	if csx < xmargin
		nu-screen-left <= csi - xmargin
	elif csx > sw - xmargin
		nu-screen-left <= csi - (sw - xmargin)
	nu-screen-left = Math.max(nu-screen-left, 0)

	nu-screen-top = sc-off.screen-top
	if csy < ymargin
		nu-screen-top <= cur.line - ymargin
	elif csy > sh - ymargin
		nu-screen-top <= cur.line - (sh - ymargin)
	nu-screen-top = Math.max(nu-screen-top, 0)

	pane <&.sc-off= { screen-top: nu-screen-top, screen-left: nu-screen-left }


fn set-colors (screen Ptr (Screen Allocator), colors Theme.Colors, intensity F32)
	screen Tui.set-screen-colors(colors.fg Term.set-color-intensity-to(intensity), colors.bg Term.set-color-intensity-to(intensity))


fn render (screen Ptr (Screen al), pane Ptr (Pane al), sd ScreenDims, cfg Ptr Config, is-active Bool) <= Allocator al
	intensity = if is-active: 1 else (3/4)
	theme = cfg&.theme
	display-line-numbers = cfg&.display-line-numbers
	relative-line-numbers = cfg&.relative-line-numbers

	max-line-num-chars = pane&.buf TextBuf.num-lines() chars() count() Mem.size-i32()
	num-front-margin = 2
	num-back-margin = 2
	total-margin = if display-line-numbers: max-line-num-chars + num-front-margin + num-back-margin else 0
	
	# moves the window "in position" of the cursor.
	# must operate on total text screen area (excluding margin)
	pane update-screen-offset(sd { from-sx: sd.from-sx + total-margin })
	cur = pane current-cursor()
	
	# fill background miau
	screen set-colors(theme&.default, intensity)
	screen Tui.fill-rect(sd.from-sx, sd.to-sx, sd.from-sy, sd.to-sy)

	sc-off = pane&.sc-off
	for line-num in (sc-off.screen-top + 1) to (pane&.buf TextBuf.num-lines() Math.min(sc-off.screen-top + sd screen-height()))
		ybi = line-num - 1
		xbi = pane&.buf vi-bi(ybi, sc-off.screen-left)
		line-content = pane&.buf TextBuf.line(ybi)

		ys = sd.from-sy + line-num - sc-off.screen-top - 1

		# first draw line number
		if display-line-numbers
			if cur.pos.line == ybi  # if cursor is on this line, do special highlight
				screen set-colors(theme&.line-num-hl, intensity)
			else
				screen set-colors(theme&.line-num, intensity)

			line-display = if not relative-line-numbers or cur.pos.line == ybi: line-num else Math.abs(cur.pos.line - ybi)
			screen Tui.draw-str-right(line-display, screen&.tui&.width Mem.u32-i32() - sd.from-sx - total-margin + num-back-margin, ys)  # trust the science

			# reset em!
			screen set-colors(theme&.default, intensity)

		vx = pane&.buf pos-vi(Pos.mk(ybi, xbi)) - sc-off.screen-left
		assert(vx <= 0, 'vx must be <= 0, but got \(vx)')
		left-offset = sd.from-sx + total-margin
		for c in line-content StrView.byte-substr-from(xbi Mem.i32-size()) chars() append(' ')
			if left-offset + vx > sd.to-sx
				break

			curpos = Pos.mk(ybi, xbi)
			is-cursor = curpos == cur.pos
			in-selection = pane is-in-selection(Pos.mk(ybi, xbi))
			if is-cursor
				screen set-colors(theme&.cursor, intensity)
			elif in-selection
				screen set-colors(theme&.selection, intensity)
			else
				# check highlight
				pane&.buf TextBuf.highlight-at(curpos) if-just(fn(type))
					screen set-colors(theme Theme.find-colors-for-highlight(type), intensity)
			case c char-replacement()
				None
					if not (vx < 0 or vx + c char-screen-width() - 1 > sd.to-sx)
						screen Tui.put-char(c, left-offset + vx, ys)  # ah fuck, we are modifying the underlying buffer.
					vx <= vx + c char-screen-width()
				Just(s)
					for c in s chars()
						if vx >= 0
							screen Tui.put-char(c, left-offset + vx, ys)
						vx <= vx + c char-screen-width()

			screen set-colors(theme&.default, intensity)
			xbi <= xbi + c.num-bytes Mem.size-i32()

	# overlay
	if is-active
		screen set-colors(theme&.overlay, intensity)
		modename = pane&.mode short-mode-name()
		screen Tui.draw-str(' \(modename) ', sd.from-sx, sd.to-sy)  # idea: make mode appear briefly in the middle/lower-middle of the screen. more dynamic!


fn set-sel (self Ptr (Pane al), cur Ptr Cursor, sel Maybe Pos)
	if self&.mode /= Select
		cur <&.sel= sel

fn set-mode (self Ptr (Pane al), mode Mode) <= Allocator al
	if mode == Normal
		self&.buf TextBuf.flush-insert-action()
	self <&.mode= mode


CursorMovement
	NoChanges
	UpdateVI
	OverrideSelect # includes update vi

inst Eq CursorMovement
	eq (l _, r _):
		(case (l, r))
			(NoChanges, NoChanges): True
			(UpdateVI, UpdateVI): True
			(OverrideSelect, OverrideSelect): True
			_: False


fn set-cursors (self Ptr (Pane al), cur Ptr Cursor, pos Pos, sel Maybe Pos, cursor-movement-type CursorMovement)  # todo: change flags to a readable enum.
	if cursor-movement-type /= NoChanges
		cur <&.vi= self&.buf pos-vi(pos)
	cur <&.pos= pos
	if cursor-movement-type /= OverrideSelect
		self set-sel(cur, sel)
	else
		cur <&.sel= sel

fn override-cursors (self Ptr (Pane al), cursors Slice Cursor) <= Allocator al
	(&self&.cursors) List.replace-with(cursors)
	

fn move-right (self Ptr (Pane al))
	for cursor in self cursors()
		self set-cursors(cursor, TextBuf.right-pos(self&.buf, cursor&.pos), None, UpdateVI)

fn move-cursor-left (self Ptr (Pane al), cursor Ptr Cursor)
	self set-cursors(cursor, TextBuf.left-pos(self&.buf, cursor&.pos), None, UpdateVI)

fn move-left (self Ptr (Pane al))
	for cursor in self cursors()
		self move-cursor-left(cursor)

fn move-down (self Ptr (Pane al), amnt I32)
	for cursor in self cursors()
		pos = cursor&.pos
		nu-line = Math.min(pos.line + amnt, self&.buf TextBuf.num-lines() - 1)
	
		vci = cursor&.vi
		bi = self&.buf vi-bi(nu-line, vci)
		self set-cursors(cursor, { line: nu-line, bi }, None, NoChanges)

fn move-up (self Ptr (Pane al), amnt I32)
	for cursor in self cursors()
		pos = cursor&.pos
		nu-line = Math.max(pos.line - amnt, 0)
	
		vci = cursor&.vi
		bi = self&.buf vi-bi(nu-line, vci)
		self set-cursors(cursor, { line: nu-line, bi }, None, NoChanges)

fn is-at-line-end (pane Ptr (Pane al), pos Pos):
	pos.bi Mem.i32-size() == pane&.buf TextBuf.line(pos.line) StrView.num-bytes()

fn cursor-is-at-line-end (pane Ptr (Pane al), cursor Cursor):
	pane is-at-line-end(cursor.pos)

MoveDirection
	MoveFwd
	MoveBwd

MoveTarget
	NextWordStart
	NextWordEnd

fn reached-target (pane Ptr (Pane al), target MoveTarget, prev Pos, cur Pos):
	(case target)
		NextWordStart:
			is-word-boundary(pane char-at(prev), pane char-at(cur))
			  and not pane char-at(cur) char-type() == CharType.CharSpace
		NextWordEnd:
			is-word-boundary(pane char-at(prev), pane char-at(cur))
			  and not pane char-at(prev) char-type() == CharType.CharSpace
		_: todo()

# todo: maybe make it stateless. this will allow me to not accidentally end up setting stuff.
# todo: also this will play nicely with set-cursors merging multiple cursors.
fn advance-word (pane Ptr (Pane al), dir MoveDirection, target MoveTarget) <= Allocator al
	for cursor in pane cursors()
		prev =& cursor&.pos Misc.own()
		fn advance()
			prev <&= cursor&.pos
			case dir
				MoveFwd
					pane move-right()
				MoveBwd
					pane move-left()
	
		# skip newlines
		sel = cursor&.pos
		was-at-line-end = pane cursor-is-at-line-end(cursor&)
		advance()
		if was-at-line-end or pane reached-target(target, prev&, cursor&.pos)
			sel <= cursor&.pos
	
		while pane cursor-is-at-line-end(cursor&)
			if cursor&.pos == prev&
				return  # at the end of the file!
			advance()
			sel <= cursor&.pos
	
		# check first word boundary
		# if is-word-boundary(pane char-at(prev&), pane char-at(pane&.cursor)) and pane char-at(pane&.cursor) CharType.char-type() /= CharType.CharSpace
		# 	sel <= pane&.cursor
		while True
			advance()
			if pane cursor-is-at-line-end(cursor&) or pane reached-target(target, prev&, cursor&.pos)
				case dir
					MoveFwd
						pane move-left()
					MoveBwd
						pane move-right()
				break
	
			# when moving backwards, we might get to the start of the file. this line breaks us out.
			if prev& == cursor&.pos
				break
	
		pane set-sel(cursor, Just(sel))


fn min-pos (pane Ptr (Pane al), cursor Cursor):
	(case cursor.sel)
		Just(sel): Math.min(cursor.pos, sel)
		_: cursor.pos

fn max-pos (pane Ptr (Pane al), cursor Cursor):
	(case cursor.sel)
		Just(sel): Math.max(cursor.pos, sel)
		_: cursor.pos

fn indent-at-line (pane Ptr (Pane al), line I32) -> I32:
	pane&.buf TextBuf.line(line) take-while(fn c: c is-whitespace()) map(fn c: c.num-bytes) sum() Mem.size-i32()

# helix's 'x' cmd. 
# 1. if the ends are not already expanded, then expand current selection to ends of screen.
# 2. if it's already expanded, select next line.
fn expand(pane Ptr (Pane al))
	for cursor in pane cursors()
		min-pos = pane min-pos(cursor&)
		max-pos = pane max-pos(cursor&)
		max-pos-max = pane&.buf TextBuf.line(max-pos.line) StrView.num-bytes() Mem.size-i32()
		if not (min-pos.bi == 0 and max-pos.bi == max-pos-max)
			cursor <&.sel= min-pos { bi: 0 } Just()
			cursor <&.pos= max-pos { bi: max-pos-max }
		else
			if max-pos.line + 1 >= pane&.buf TextBuf.num-lines()
				return
	
			cursor <&.sel= min-pos { bi: 0 } Just()
			next-line = max-pos.line + 1
			cursor <&.pos= { line: next-line, bi: pane&.buf TextBuf.line(next-line) StrView.num-bytes() Mem.size-i32() }

fn move-to-beginning (self Ptr (Pane al))
	for cursor in self cursors()
		self set-cursors(cursor, cursor&.pos { bi: 0 }, None, UpdateVI)

fn move-to-beginning-indented (self Ptr (Pane al))
	for cursor in self cursors()
		indent = self indent-at-line(cursor&.pos.line)
		self set-cursors(cursor, cursor&.pos { bi: indent }, None, UpdateVI)

fn move-to-end (self Ptr (Pane al))
	for cursor in self cursors()
		pos = cursor&.pos
		self set-cursors(cursor, pos { bi: self&.buf TextBuf.line(pos.line) StrView.num-bytes() Mem.size-i32() }, None, UpdateVI)

fn line-begins-with-comment (self Ptr (Pane al), line I32) -> Maybe (Pos, Pos)
	indent = self indent-at-line(line)
	if self char-at(Pos.mk(line, indent)) == '#'
		i = indent + 1
		while (fn c: c /= '\n' and c is-whitespace())(self char-at(Pos.mk(line, i)))
			i <= i + 1
		return Just((Pos.mk(line, indent), Pos.mk(line, i)))
	else
		return None


# modification

fn add-str-at-char (self Ptr (Pane al), s StrView) <= Allocator al
	for cursor in self cursors()
		cur = cursor&.pos
		self&.buf TextBuf.change(cur, cur, s, None)

fn backspace (self Ptr (Pane Allocator))
	for cursor in self cursors()
		prev-cur = cursor&.pos
		self move-cursor-left(cursor)
		self&.buf TextBuf.change(cursor&.pos, prev-cur, '', None)

fn undo (self Ptr (Pane al)) <= Allocator al
	mcursors = self&.buf TextBuf.undo()
	mcursors if-just(fn(cursors))
		# self set-cursors(cursors.cur, cursors.sel, OverrideSelect)
		self override-cursors(cursors)

fn redo (self Ptr (Pane al)) <= Allocator al
	mcursors = self&.buf TextBuf.redo()
	mcursors if-just(fn(cursors))
		# self set-cursors(cursors.cur, cursors.sel, OverrideSelect)
		self override-cursors(cursors)


